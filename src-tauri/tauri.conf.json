{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkvoice",
  "version": "0.3.1",
  "identifier": "com.inkvoice.desktop",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../packages/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkvoice",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/inkvoice-backend"],
    "resources": ["../templates"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
